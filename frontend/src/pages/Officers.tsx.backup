    name: "Amit Tiwari",
    beltNumber: "BK-07654",
    rank: "Head Constable",
    department: "Control Room",
    headquarters: "Jalaun HQ",
    district: "Jalaun",
    mobile: "94XXXXXX34",
    status: "Retired",
  },
  {
    id: "PHQ-13567",
    name: "Sanjay Yadav",
    beltNumber: "BK-13567",
    rank: "Constable",
    department: "Traffic Police",
    headquarters: "Kanpur HQ",
    district: "Kanpur Nagar",
    mobile: "93XXXXXX89",
    status: "Active",
  },
  {
    id: "PHQ-14678",
    name: "Neha Gupta",
    beltNumber: "BK-14678",
    rank: "Assistant Sub Inspector",
    department: "CID",
    headquarters: "Lucknow HQ",
