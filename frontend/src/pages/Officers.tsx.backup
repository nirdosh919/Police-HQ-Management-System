import {
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  Eye,
  Filter,
  Pencil,
  Search,
  UserPlus,
  X,
} from "lucide-react";

import { useMemo, useState } from "react";

type OfficerStatus = "Active" | "Suspended" | "Retired";

type Officer = {
  id: string;
  name: string;
  beltNumber: string;
  rank: string;
  department: string;
  headquarters: string;
  district: string;
  mobile: string;
  status: OfficerStatus;
};

const officers: Officer[] = [
  {
    id: "PHQ-10245",
    name: "Raj Kumar",
    beltNumber: "BK-10245",
    rank: "Inspector",
    department: "Crime Branch",
    headquarters: "Police Headquarters",
    district: "Kanpur Nagar",
    mobile: "98XXXXXX21",
    status: "Active",
  },
  {
    id: "PHQ-11482",
    name: "Anita Sharma",
    beltNumber: "BK-11482",
    rank: "Sub Inspector",
    department: "Cyber Cell",
    headquarters: "Lucknow HQ",
    district: "Lucknow",
    mobile: "97XXXXXX42",
    status: "Active",
  },
  {
    id: "PHQ-09321",
    name: "Vivek Singh",
    beltNumber: "BK-09321",
    rank: "DSP",
    department: "Traffic Police",
    headquarters: "Jhansi HQ",
    district: "Jhansi",
    mobile: "96XXXXXX18",
    status: "Active",
  },
  {
    id: "PHQ-12874",
    name: "Priya Verma",
    beltNumber: "BK-12874",
    rank: "Inspector",
    department: "Women Cell",
    headquarters: "Kanpur HQ",
    district: "Kanpur Dehat",
    mobile: "95XXXXXX67",
